 115:Core/Src/mimic_core.c **** /**
 116:Core/Src/mimic_core.c ****   * @brief  Process incoming commands (call in main loop)
 117:Core/Src/mimic_core.c ****   */
 118:Core/Src/mimic_core.c **** void Mimic_Process(void)
 119:Core/Src/mimic_core.c **** {
 120:Core/Src/mimic_core.c **** 
 121:Core/Src/mimic_core.c **** 
 122:Core/Src/mimic_core.c ****     /* Process all available bytes from interrupt buffer */
 123:Core/Src/mimic_core.c ****     while (Mimic_RxAvailable())
 124:Core/Src/mimic_core.c ****     {
 125:Core/Src/mimic_core.c ****         uint8_t rx = Mimic_RxGet();
 126:Core/Src/mimic_core.c ****         
 127:Core/Src/mimic_core.c ****         /* Handle special characters */
 128:Core/Src/mimic_core.c ****         if (rx == '\r' || rx == '\n')
 129:Core/Src/mimic_core.c ****         {
 130:Core/Src/mimic_core.c ****             if (mimic_state.cmd_index > 0)
 131:Core/Src/mimic_core.c ****             {
 132:Core/Src/mimic_core.c ****                 Mimic_SendResponse("\r\n");
 133:Core/Src/mimic_core.c ****                 mimic_state.cmd_buffer[mimic_state.cmd_index] = '\0';
 134:Core/Src/mimic_core.c ****                 Mimic_ProcessCommand(mimic_state.cmd_buffer);
 135:Core/Src/mimic_core.c ****                 mimic_state.cmd_index = 0;
 136:Core/Src/mimic_core.c ****                 Mimic_SendResponse("> ");
 137:Core/Src/mimic_core.c ****             }
 138:Core/Src/mimic_core.c ****         }
 139:Core/Src/mimic_core.c ****         else if (rx == '\b' || rx == 127)  /* Backspace */
 140:Core/Src/mimic_core.c ****         {
 141:Core/Src/mimic_core.c ****             if (mimic_state.cmd_index > 0)
 142:Core/Src/mimic_core.c ****             {
 143:Core/Src/mimic_core.c ****                 mimic_state.cmd_index--;
 144:Core/Src/mimic_core.c ****                 Mimic_SendResponse(" \b");  /* Erase character */
 145:Core/Src/mimic_core.c ****             }
 146:Core/Src/mimic_core.c ****         }
 147:Core/Src/mimic_core.c ****         else if (rx >= 32 && rx < 127)  /* Printable */
 148:Core/Src/mimic_core.c ****         {
 149:Core/Src/mimic_core.c ****             if (mimic_state.cmd_index < MIMIC_MAX_CMD_LEN - 1)
 150:Core/Src/mimic_core.c ****             {
 151:Core/Src/mimic_core.c ****                 mimic_state.cmd_buffer[mimic_state.cmd_index++] = rx;
 152:Core/Src/mimic_core.c ****             }
 153:Core/Src/mimic_core.c ****         }
 154:Core/Src/mimic_core.c ****     }
