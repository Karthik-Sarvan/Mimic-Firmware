  32:Core/Src/mimic_core.c **** /**
  33:Core/Src/mimic_core.c ****   * @brief  UART RX Complete Callback (called from interrupt)
  34:Core/Src/mimic_core.c ****   */
  35:Core/Src/mimic_core.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
  36:Core/Src/mimic_core.c **** {
  37:Core/Src/mimic_core.c ****     if (huart == &MIMIC_HOST_UART)
  38:Core/Src/mimic_core.c ****     {
  39:Core/Src/mimic_core.c ****         /* Store in circular buffer */
  40:Core/Src/mimic_core.c ****         uint16_t next_head = (rx_head + 1) % RX_BUFFER_SIZE;
  41:Core/Src/mimic_core.c ****         if (next_head != rx_tail)  /* Buffer not full */
  42:Core/Src/mimic_core.c ****         {
  43:Core/Src/mimic_core.c ****             rx_buffer[rx_head] = rx_byte;
  44:Core/Src/mimic_core.c ****             rx_head = next_head;
  45:Core/Src/mimic_core.c ****         }
  46:Core/Src/mimic_core.c ****         
  47:Core/Src/mimic_core.c ****         /* Re-enable interrupt for next byte */
  48:Core/Src/mimic_core.c ****         HAL_UART_Receive_IT(&MIMIC_HOST_UART, (uint8_t*)&rx_byte, 1);
  49:Core/Src/mimic_core.c ****     }
  50:Core/Src/mimic_core.c **** }
